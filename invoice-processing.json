        "responses": {
          "values": [
            {
              "content": "=Extract this invoice as strict JSON only, no markdown, no explanation:\n{\"vendor\": \"\", \"invoice_number\": \"\", \"date\": \"\", \"line_items\": [], \"subtotal\": 0, \"tax\": 0, \"total\": 0}\nIf a field is unreadable or missing, output null — never guess a number.\n\nInvoice text:\n{{ $json.text }}"
            }
          ]
        },
        "builtInTools": {},
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 2.3,
      "position": [
        464,
        0
      ],
      "id": "e936765b-c959-4664-a17a-1a9497f87608",
      "name": "Message a model",
      "credentials": {
        "openAiApi": {
          "id": "YOUR_CREDENTIAL_ID",
          "name": "OpenAI account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  let data;\n  try {\n    const raw = item.json.output[0].content[0].text;\n    data = JSON.parse(raw);\n  } catch (e) {\n    results.push({ json: { valid: false, reason: \"extraction failed\" } });\n    continue;\n  }\n\n  const subtotal = Number(data.subtotal) || 0;\n  const tax = Number(data.tax) || 0;\n  const total = Number(data.total) || 0;\n  const computed = subtotal + tax;\n  const withinTolerance = Math.abs(computed - total) < 0.02;\n\n  results.push({\n    json: {\n      ...data,\n      valid: withinTolerance,\n      reason: withinTolerance ? null : `subtotal+tax (${computed}) != total (${total})`,\n    },\n  });\n}\n\nreturn results;\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
